// Static-assets-only Worker for the Unwind design site.
// Build first:  node docs/design/site/build.mjs   (→ ./public)
// Deploy:       cd docs/design/site && npx wrangler deploy   (needs `wrangler login`)
{
  "name": "unwind-design",
  "compatibility_date": "2026-06-01",
  "assets": { "directory": "./public", "not_found_handling": "404-page" }
  // TODO: confirm the public custom domain before the first deploy, then add e.g.:
  // , "routes": [{ "pattern": "unwind-design.cliftonc.nl", "custom_domain": true }]
}
